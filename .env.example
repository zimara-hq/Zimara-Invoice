# ---- Required ----
# PostgreSQL 16+ (hosted inside Saudi Arabia in production)
DATABASE_URL=postgresql://zimara:CHANGE_ME@localhost:5432/zimara
# Set to true when your database requires TLS (managed cloud databases)
DATABASE_SSL=false
# 32 random bytes, base64. Encrypts EGS private keys and Fatoora credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ZIMARA_KEY_ENCRYPTION_KEY=
# Public URL of the app (used in email links)
APP_URL=http://localhost:3000

# ---- Email (verification and password reset) ----
# smtp://user:pass@smtp.example.com:587  — leave empty in development to print emails to the server log
SMTP_URL=
MAIL_FROM=زيمارا <no-reply@zimara.co>

# ---- ZATCA ----
# Only enable after passing the simulation environment
ZATCA_ALLOW_PRODUCTION=false
# Secret for the retry job: POST /api/cron/zatca with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ---- AI assistant (optional) ----
ANTHROPIC_API_KEY=

# ---- Your company identity (E-Commerce Law: shown in the site footer and legal pages) ----
COMPANY_LEGAL_NAME=
COMPANY_CRN=
COMPANY_VAT=
COMPANY_ADDRESS=حائل، المملكة العربية السعودية
COMPANY_EMAIL=hello@zimara.co
# Set to true (at build time) after a licensed Saudi lawyer has reviewed the legal pages
LEGAL_REVIEWED=false
