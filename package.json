{
  "name": "zimara-invoice",
  "version": "0.1.0",
  "private": true,
  "description": "زيمارا للفوترة الإلكترونية - نظام فوترة متوافق مع هيئة الزكاة والضريبة والجمارك",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs",
    "zatca:sandbox-check": "ZATCA_SANDBOX=1 vitest run tests/zatca-sandbox.test.ts",
    "test:e2e": "node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@node-rs/argon2": "2.0.2",
    "next": "15.5.29",
    "nodemailer": "10.3.1",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5"
  }
}
